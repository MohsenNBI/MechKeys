{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MechKeys",
  "mainBinaryName": "mechkeys",
  "version": "1.7.0",
  "identifier": "ir.mohsen.mechkeys",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MechKeys",
        "width": 400,
        "height": 712,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
